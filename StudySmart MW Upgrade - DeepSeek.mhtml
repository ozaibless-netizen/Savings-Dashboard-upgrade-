<span>    <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>style</span><span class="token punctuation">&gt;</span></span></span>
<span>        * {</span>
<span>            margin: 0;</span>
<span>            padding: 0;</span>
<span>            box-sizing: border-box;</span>
<span>        }</span>
<span></span>
<span>        :root {</span>
<span>            --primary: #0f2b3d;</span>
<span>            --primary-dark: #0a1e2c;</span>
<span>            --primary-light: #1e4a6e;</span>
<span>            --accent: #f4a261;</span>
<span>            --accent-dark: #e76f51;</span>
<span>            --accent-light: #f8e5cd;</span>
<span>            --success: #2a9d8f;</span>
<span>            --danger: #e63946;</span>
<span>            --warning: #e9c46a;</span>
<span>            --gray-100: #f8f9fa;</span>
<span>            --gray-200: #e9ecef;</span>
<span>            --gray-300: #dee2e6;</span>
<span>            --gray-600: #6c757d;</span>
<span>            --gray-800: #343a40;</span>
<span>            --gray-900: #212529;</span>
<span>            --shadow-sm: 0 1px 3px rgba(0,0,0,0.12);</span>
<span>            --shadow-md: 0 4px 6px rgba(0,0,0,0.1);</span>
<span>            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);</span>
<span>            --radius: 16px;</span>
<span>            --radius-sm: 8px;</span>
<span>        }</span>
<span></span>
<span>        body {</span>
<span>            font-family: 'Inter', sans-serif;</span>
<span>            background: linear-gradient(135deg, #f5f7fa 0%, #f0f2f5 100%);</span>
<span>            color: var(--gray-900);</span>
<span>            min-height: 100vh;</span>
<span>        }</span>
<span></span>
<span>        /* Navigation */</span>
<span>        nav {</span>
<span>            background: rgba(255, 255, 255, 0.95);</span>
<span>            backdrop-filter: blur(10px);</span>
<span>            border-bottom: 1px solid rgba(0,0,0,0.05);</span>
<span>            position: sticky;</span>
<span>            top: 0;</span>
<span>            z-index: 1000;</span>
<span>        }</span>
<span>        .nav-inner {</span>
<span>            max-width: 1400px;</span>
<span>            margin: 0 auto;</span>
<span>            padding: 0 32px;</span>
<span>            display: flex;</span>
<span>            align-items: center;</span>
<span>            justify-content: space-between;</span>
<span>            height: 70px;</span>
<span>        }</span>
<span>        .logo {</span>
<span>            display: flex;</span>
<span>            align-items: center;</span>
<span>            gap: 12px;</span>
<span>            font-weight: 800;</span>
<span>            font-size: 1.3rem;</span>
<span>            color: var(--primary);</span>
<span>            text-decoration: none;</span>
<span>        }</span>
<span>        .logo-icon {</span>
<span>            width: 40px;</span>
<span>            height: 40px;</span>
<span>            background: linear-gradient(135deg, var(--primary), var(--primary-light));</span>
<span>            border-radius: 12px;</span>
<span>            display: flex;</span>
<span>            align-items: center;</span>
<span>            justify-content: center;</span>
<span>            color: white;</span>
<span>        }</span>
<span>        .logo span { background: linear-gradient(135deg, var(--accent), var(--accent-dark)); background-clip: text; -webkit-background-clip: text; color: transparent; }</span>
<span>        .nav-links { display: flex; gap: 8px; list-style: none; }</span>
<span>        .nav-links a { text-decoration: none; color: var(--gray-600); font-weight: 500; padding: 8px 16px; border-radius: 10px; transition: 0.2s; }</span>
<span>        .nav-links a:hover, .nav-links a.active { background: var(--accent-light); color: var(--accent-dark); }</span>
<span>        .btn { padding: 10px 20px; border-radius: 10px; font-weight: 600; border: none; cursor: pointer; font-family: inherit; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; }</span>
<span>        .btn-primary { background: linear-gradient(135deg, var(--primary), var(--primary-light)); color: white; }</span>
<span>        .btn-outline { background: transparent; border: 1.5px solid var(--gray-300); color: var(--gray-800); }</span>
<span>        .btn-outline:hover { border-color: var(--accent); background: var(--accent-light); }</span>
<span></span>
<span>        /* Cards &amp; Grid */</span>
<span>        .page { display: none; animation: fadeIn 0.3s ease; }</span>
<span>        .page.active { display: block; }</span>
<span>        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }</span>
<span>        </span>
<span>        .subjects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; }</span>
<span>        .subject-card { background: white; padding: 28px 20px; border-radius: var(--radius); text-align: center; cursor: pointer; transition: all 0.3s; border: 1px solid var(--gray-200); box-shadow: var(--shadow-sm); }</span>
<span>        .subject-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: var(--accent); }</span>
<span>        .subject-icon { width: 64px; height: 64px; border-radius: 20px; margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; font-size: 2rem; }</span>
<span></span>
<span>        /* Admin Panel */</span>
<span>        .admin-layout { display: flex; min-height: calc(100vh - 70px); }</span>
<span>        .admin-sidebar { width: 260px; background: var(--primary-dark); color: white; padding: 24px 0; }</span>
<span>        .sidebar-item { padding: 12px 24px; display: flex; align-items: center; gap: 12px; cursor: pointer; transition: 0.2s; margin: 4px 12px; border-radius: 10px; }</span>
<span>        .sidebar-item:hover, .sidebar-item.active { background: rgba(255,255,255,0.15); }</span>
<span>        .admin-main { flex: 1; padding: 28px; background: var(--gray-100); overflow-y: auto; }</span>
<span>        .stat-card { background: white; border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow-sm); border: 1px solid var(--gray-200); }</span>
<span>        .admin-table { width: 100%; background: white; border-radius: var(--radius); border-collapse: collapse; overflow: hidden; }</span>
<span>        .admin-table th, .admin-table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--gray-200); }</span>
<span>        .progress-bar-bg { background: var(--gray-200); border-radius: 20px; height: 8px; width: 100%; overflow: hidden; }</span>
<span>        .progress-fill { background: var(--success); height: 100%; width: 0%; transition: width 0.3s; }</span>
<span></span>
<span>        /* Upload raw notes */</span>
<span>        .upload-zone { border: 2px dashed var(--gray-300); border-radius: var(--radius); padding: 30px; text-align: center; background: white; cursor: pointer; transition: 0.2s; }</span>
<span>        .upload-zone:hover { border-color: var(--accent); background: var(--accent-light); }</span>
<span>        .toast { position: fixed; bottom: 30px; right: 30px; background: var(--gray-900); color: white; padding: 12px 24px; border-radius: 10px; z-index: 9999; transform: translateX(400px); transition: 0.3s; }</span>
<span>        .toast.show { transform: translateX(0); }</span>
<span>        footer { background: var(--primary-dark); color: white; padding: 40px 20px; text-align: center; margin-top: 60px; }</span>
<span>        @media (max-width: 768px) { .admin-sidebar { display: none; } .nav-links { display: none; } }</span>
