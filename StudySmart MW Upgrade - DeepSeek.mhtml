<span>    // AI Chat</span>
<span>    function sendAIMessage() {</span>
<span>        let input = document.getElementById('chatInput');</span>
<span>        let msg = input.value.trim();</span>
<span>        if(!msg) return;</span>
<span>        let chatDiv = document.getElementById('chatMessages');</span>
<span>        chatDiv.innerHTML += `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>margin:8px 0; text-align:right;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>strong</span><span class="token punctuation">&gt;</span></span>You:<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>strong</span><span class="token punctuation">&gt;</span></span> ${msg}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        let reply = "I'm your MSCE AI tutor. Ask me about DNA, Macbeth, trigonometry, chemical bonding, or past papers!";</span>
<span>        const lc = msg.toLowerCase();</span>
<span>        if(lc.includes("dna")) reply = "üß¨ DNA: Double helix, base pairs A-T and G-C. Replication is semi-conservative. Exam tip: DNA ‚Üí RNA ‚Üí Protein is the Central Dogma.";</span>
<span>        else if(lc.includes("macbeth")) reply = "üé≠ Macbeth: ambition leads to downfall. Key themes: guilt, supernatural, appearance vs reality. Use quotes like 'Out, damned spot!' for essays.";</span>
<span>        else if(lc.includes("trig") || lc.includes("sin")) reply = "üìê SOH-CAH-TOA! Sin=Opp/Hyp, Cos=Adj/Hyp, Tan=Opp/Adj. Practice right-angled triangles.";</span>
<span>        else if(lc.includes("bonding")) reply = "‚öõÔ∏è Chemical bonding: Ionic (electron transfer), Covalent (sharing), Metallic (electron sea). Know properties for MSCE.";</span>
<span>        else if(lc.includes("progress")) reply = `You have ${userProgress[currentUser]?.points || 0} points and completed ${userProgress[currentUser]?.completed.length || 0} topics.`;</span>
<span>        chatDiv.innerHTML += `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>margin:8px 0;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>strong</span><span class="token punctuation">&gt;</span></span>ü§ñ AI:<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>strong</span><span class="token punctuation">&gt;</span></span> ${reply}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        chatDiv.scrollTop = chatDiv.scrollHeight;</span>
<span>        input.value = '';</span>
<span>    }</span>
