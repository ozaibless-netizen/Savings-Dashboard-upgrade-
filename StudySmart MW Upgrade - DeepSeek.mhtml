<span>    // Open subject &amp; show topics (with raw content)</span>
<span>    function openSubject(subject) {</span>
<span>        let filtered = topicsDB.filter(t =&gt; t.subject === subject);</span>
<span>        let container = document.getElementById('subjectDetailContent');</span>
<span>        container.innerHTML = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>h2</span><span class="token punctuation">&gt;</span></span>${subject.toUpperCase()} Topics<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>h2</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>topics-grid<span class="token punctuation">"</span></span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>display:grid; gap:12px; margin-top:20px;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>${filtered.map(t =&gt; `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>subject-card<span class="token punctuation">"</span></span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>text-align:left; padding:16px;<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>viewTopic('${t.id}')<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>strong</span><span class="token punctuation">&gt;</span></span>${t.title}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>strong</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>p</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>font-size:0.85rem;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>${t.rawContent?.substring(0,80)}...<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>p</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`).join('')}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        showPage('subject-detail');</span>
<span>    }</span>
<span>    function viewTopic(id) {</span>
<span>        let topic = topicsDB.find(t =&gt; t.id == id);</span>
<span>        if(!topic) { showToast("Topic not found"); return; }</span>
<span>        sessionStorage.setItem("currentTopicId", id);</span>
<span>        let contentDiv = document.getElementById('topicFullContent');</span>
<span>        contentDiv.innerHTML = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>h1</span><span class="token punctuation">&gt;</span></span>${topic.title}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>h1</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>background:white; padding:24px; border-radius:var(--radius); margin-top:16px; white-space:pre-wrap; line-height:1.6;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>${topic.rawContent || "No content yet. Admin can upload raw notes."}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        showPage('topic-view');</span>
<span>    }</span>
<span></span>
<span>    // AI simple chat (custom responses)</span>
<span>    function sendAIMessage() {</span>
<span>        let input = document.getElementById('chatInput');</span>
<span>        let msg = input.value.trim();</span>
<span>        if(!msg) return;</span>
<span>        let chatDiv = document.getElementById('chatMessages');</span>
<span>        chatDiv.innerHTML += `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>margin:8px 0; text-align:right;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>strong</span><span class="token punctuation">&gt;</span></span>You:<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>strong</span><span class="token punctuation">&gt;</span></span> ${msg}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        let reply = "I'm your MSCE study AI. Ask about topics like DNA, Macbeth, or check the 'Raw Notes' uploaded by admin.";</span>
<span>        if(msg.toLowerCase().includes("dna")) reply = "DNA is a double helix with A-T, G-C base pairs. Raw notes section has detailed explanations!";</span>
<span>        else if(msg.toLowerCase().includes("macbeth")) reply = "Macbeth: ambition, guilt, and supernatural. The raw notes uploaded contain full analysis.";</span>
<span>        else if(msg.toLowerCase().includes("progress")) reply = `Your current progress: ${userProgress[currentUser]?.points || 0} points, ${userProgress[currentUser]?.completed.length || 0} topics mastered.`;</span>
<span>        setTimeout(() =&gt; { chatDiv.innerHTML += `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>margin:8px 0;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>strong</span><span class="token punctuation">&gt;</span></span>AI:<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>strong</span><span class="token punctuation">&gt;</span></span> ${reply}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`; chatDiv.scrollTop = chatDiv.scrollHeight; }, 200);</span>
<span>        input.value = '';</span>
<span>    }</span>
<span></span>
<span>    // ---------- ADMIN DASHBOARD REAL RENDERING ----------</span>
<span>    function renderAdminPanels() {</span>
<span>        if(!loggedAdmin) return;</span>
<span>        // stats</span>
<span>        let allUsers = Object.keys(userProgress);</span>
<span>        let totalCompletions = Object.values(userProgress).reduce((acc,u) =&gt; acc + (u.completed?.length || 0), 0);</span>
<span>        document.getElementById('statUsers').innerText = allUsers.length;</span>
<span>        document.getElementById('statCompletions').innerText = totalCompletions;</span>
<span>        document.getElementById('statNotes').innerText = rawNotesDB.length;</span>
<span>        // raw notes list</span>
<span>        let rawListDiv = document.getElementById('rawNotesList');</span>
<span>        if(rawListDiv) rawListDiv.innerHTML = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>h3</span><span class="token punctuation">&gt;</span></span>üìÅ Stored Raw Notes (exact content)<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>h3</span><span class="token punctuation">&gt;</span></span>${rawNotesDB.map(n =&gt; `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>border-bottom:1px solid #ddd; padding:12px;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>b</span><span class="token punctuation">&gt;</span></span>${n.title}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>b</span><span class="token punctuation">&gt;</span></span> (${n.subject})<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>br</span><span class="token punctuation">/&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>small</span><span class="token punctuation">&gt;</span></span>${n.rawContent.substring(0,150)}...<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>small</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>button</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>btn btn-outline<span class="token punctuation">"</span></span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>margin-top:5px;<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>deleteRawNote('${n.id}')<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>Delete<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>button</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`).join('')}`;</span>
<span>        // manage topics</span>
<span>        let adminTopicsDiv = document.getElementById('adminTopicsList');</span>
<span>        if(adminTopicsDiv) adminTopicsDiv.innerHTML = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>table</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>admin-table<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>tr</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>th</span><span class="token punctuation">&gt;</span></span>Title<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>th</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>th</span><span class="token punctuation">&gt;</span></span>Subject<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>th</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>th</span><span class="token punctuation">&gt;</span></span>Actions<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>th</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>tr</span><span class="token punctuation">&gt;</span></span>${topicsDB.map(t =&gt; `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>tr</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>td</span><span class="token punctuation">&gt;</span></span>${t.title}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>td</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>td</span><span class="token punctuation">&gt;</span></span>${t.subject}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>td</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>td</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>button</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>btn btn-outline<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>editTopicRaw('${t.id}')<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>Edit Raw<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>button</span><span class="token punctuation">&gt;</span></span> <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>button</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>btn btn-outline<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>deleteTopic('${t.id}')<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>Delete<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>button</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>td</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>tr</span><span class="token punctuation">&gt;</span></span>`).join('')}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>table</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        // user progress table</span>
<span>        let usersDiv = document.getElementById('allUsersProgress');</span>
<span>        if(usersDiv) usersDiv.innerHTML = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>table</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>admin-table<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>tr</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>th</span><span class="token punctuation">&gt;</span></span>User<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>th</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>th</span><span class="token punctuation">&gt;</span></span>Completed Topics<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>th</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>th</span><span class="token punctuation">&gt;</span></span>Points<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>th</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>tr</span><span class="token punctuation">&gt;</span></span>${Object.entries(userProgress).map(([uname,data]) =&gt; `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>tr</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>td</span><span class="token punctuation">&gt;</span></span>${uname}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>td</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>td</span><span class="token punctuation">&gt;</span></span>${data.completed.length}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>td</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>td</span><span class="token punctuation">&gt;</span></span>${data.points}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>td</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>tr</span><span class="token punctuation">&gt;</span></span>`).join('')}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>table</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        let activity = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span><span class="token punctuation">&gt;</span></span>üìå Last uploads: ${rawNotesDB.slice(-3).map(n=&gt;n.title).join(', ') || 'none'}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        document.getElementById('activityLog').innerHTML = activity;</span>
<span>    }</span>
<span>    function deleteRawNote(id) { rawNotesDB = rawNotesDB.filter(n =&gt; n.id != id); topicsDB = topicsDB.filter(t =&gt; t.id != `raw_${id}` &amp;&amp; t.id != id); saveAllData(); renderAdminPanels(); showToast("Deleted"); }</span>
<span>    function deleteTopic(id) { topicsDB = topicsDB.filter(t =&gt; t.id != id); saveAllData(); renderAdminPanels(); }</span>
<span>    function editTopicRaw(id) {</span>
<span>        let topic = topicsDB.find(t =&gt; t.id == id);</span>
<span>        if(topic) {</span>
<span>            let newContent = prompt("Edit raw content (exact text, no summarization):", topic.rawContent);</span>
<span>            if(newContent !== null) { topic.rawContent = newContent; saveAllData(); renderAdminPanels(); showToast("Raw content updated"); }</span>
<span>        }</span>
<span>    }</span>
<span>    function setAdminTab(tab) {</span>
<span>        document.getElementById('adminDashboardTab').style.display = 'none';</span>
<span>        document.getElementById('adminUploadNotesTab').style.display = 'none';</span>
<span>        document.getElementById('adminManageTopicsTab').style.display = 'none';</span>
<span>        document.getElementById('adminUserProgressTab').style.display = 'none';</span>
<span>        if(tab === 'dashboard') document.getElementById('adminDashboardTab').style.display = 'block';</span>
<span>        if(tab === 'uploadNotes') document.getElementById('adminUploadNotesTab').style.display = 'block';</span>
<span>        if(tab === 'manageTopics') document.getElementById('adminManageTopicsTab').style.display = 'block';</span>
<span>        if(tab === 'userProgress') document.getElementById('adminUserProgressTab').style.display = 'block';</span>
<span>        if(tab === 'uploadNotes') renderAdminPanels();</span>
<span>    }</span>
<span></span>
<span>    // Initialize and set default demo content if empty</span>
<span>    if(topicsDB.length === 0) {</span>
<span>        topicsDB = [{ id:"dna", title:"DNA Structure", subject:"biology", rawContent:"DNA double helix: A pairs with T, G pairs with C. Contains genetic code." },</span>
<span>                    { id:"macbeth", title:"Macbeth", subject:"english", rawContent:"Macbeth by Shakespeare. Themes: ambition, guilt, supernatural. Key quotes: 'Is this a dagger?'" }];</span>
<span>        saveAllData();</span>
<span>    }</span>
<span>    window.showPage = showPage; window.openSubject = openSubject; window.viewTopic = viewTopic; window.markTopicComplete = markTopicComplete;</span>
<span>    window.handleRawFileUpload = handleRawFileUpload; window.saveRawNotes = saveRawNotes; window.deleteRawNote = deleteRawNote;</span>
<span>    window.editTopicRaw = editTopicRaw; window.deleteTopic = deleteTopic; window.setAdminTab = setAdminTab; window.logoutAdmin = logoutAdmin;</span>
<span>    window.handleAuthClick = handleAuthClick; window.sendAIMessage = sendAIMessage;</span>
<span>    renderProgressPage();</span>
