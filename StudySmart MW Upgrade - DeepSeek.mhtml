<span></span>
<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>script</span><span class="token punctuation">&gt;</span></span></span>
<span>    // ---------- REAL AUTH ----------</span>
<span>    const ADMIN_CRED = { username: "admin@studysmart.mw", password: "Admin2025!" };</span>
<span>    let loggedAdmin = false;</span>
<span></span>
<span>    // ---------- STORAGE KEYS ----------</span>
<span>    let rawNotesDB = JSON.parse(localStorage.getItem("studysmart_raw_notes") || "[]");</span>
<span>    let topicsDB = JSON.parse(localStorage.getItem("studysmart_topics") || '[{"id":"dna","title":"DNA Basics","subject":"biology","rawContent":"DNA stands for Deoxyribonucleic Acid. It contains genetic instructions. Base pairs: A-T, G-C."},{"id":"macbeth","title":"Macbeth Themes","subject":"english","rawContent":"Ambition, guilt, supernatural. Key quotes: 'Out, damned spot!'"}]');</span>
<span>    let userProgress = JSON.parse(localStorage.getItem("studysmart_progress") || '{"guest":{"completed":[],"points":0}}');</span>
<span>    let currentUser = localStorage.getItem("currentUser") || "guest";</span>
<span></span>
<span>    // Helper functions</span>
<span>    function saveAllData() {</span>
<span>        localStorage.setItem("studysmart_raw_notes", JSON.stringify(rawNotesDB));</span>
<span>        localStorage.setItem("studysmart_topics", JSON.stringify(topicsDB));</span>
<span>        localStorage.setItem("studysmart_progress", JSON.stringify(userProgress));</span>
<span>        if (loggedAdmin) renderAdminPanels();</span>
<span>        renderProgressPage();</span>
<span>    }</span>
<span></span>
<span>    function showToast(msg) { let t = document.getElementById('toastMsg'); t.innerText = msg; t.classList.add('show'); setTimeout(()=&gt;t.classList.remove('show'),3000); }</span>
<span></span>
<span>    function showPage(page) {</span>
<span>        document.querySelectorAll('.page').forEach(p =&gt; p.classList.remove('active'));</span>
<span>        document.getElementById(`page-${page}`).classList.add('active');</span>
<span>        if(page === 'progress') renderProgressPage();</span>
<span>        if(page === 'admin-dashboard' &amp;&amp; !loggedAdmin) { showToast("üîê Admin access required"); showPage('home'); return; }</span>
<span>        if(page === 'admin-dashboard' &amp;&amp; loggedAdmin) renderAdminPanels();</span>
<span>    }</span>
<span></span>
<span>    function handleAuthClick() {</span>
<span>        if(loggedAdmin) { logoutAdmin(); return; }</span>
<span>        let pwd = prompt("üîê Admin Login\nUsername: admin@studysmart.mw\nPassword:");</span>
<span>        let user = prompt("Username:");</span>
<span>        if(user === ADMIN_CRED.username &amp;&amp; pwd === ADMIN_CRED.password) {</span>
<span>            loggedAdmin = true;</span>
<span>            showToast("‚úÖ Admin authenticated");</span>
<span>            showPage('admin-dashboard');</span>
<span>            renderAdminPanels();</span>
<span>        } else { showToast("‚ùå Invalid credentials. Use admin@studysmart.mw / Admin2025!"); }</span>
<span>    }</span>
<span>    function logoutAdmin() { loggedAdmin = false; showToast("Logged out"); showPage('home'); }</span>
<span></span>
<span>    // ---------- RAW NOTES UPLOAD (NO SUMMARIZATION) ----------</span>
<span>    function handleRawFileUpload(event) {</span>
<span>        const file = event.target.files[0];</span>
<span>        if(!file) return;</span>
<span>        const reader = new FileReader();</span>
<span>        reader.onload = function(e) {</span>
<span>            let content = e.target.result;</span>
<span>            let title = prompt("Enter topic title:", file.name.split('.')[0]);</span>
<span>            if(title) {</span>
<span>                let subject = prompt("Subject (biology/chemistry/mathematics/physics/english):", "biology");</span>
<span>                rawNotesDB.push({ id: Date.now(), title: title, subject: subject, rawContent: content, createdAt: new Date().toISOString() });</span>
<span>                // Also create a viewable topic</span>
<span>                topicsDB.push({ id: "raw_"+Date.now(), title: title, subject: subject, rawContent: content });</span>
<span>                saveAllData();</span>
<span>                showToast("üìÑ Raw notes saved (exact content, no summarization)");</span>
<span>                if(loggedAdmin) renderAdminPanels();</span>
<span>            }</span>
<span>        };</span>
<span>        reader.readAsText(file);</span>
<span>    }</span>
<span>    function saveRawNotes() {</span>
<span>        let rawText = document.getElementById('rawTextArea').value.trim();</span>
<span>        if(!rawText) { showToast("Paste some notes first"); return; }</span>
<span>        let title = prompt("Topic title:", "Study Notes");</span>
<span>        if(title) {</span>
<span>            let subject = prompt("Subject (biology/chemistry/mathematics/physics/english):", "biology");</span>
<span>            rawNotesDB.push({ id: Date.now(), title: title, subject: subject, rawContent: rawText, createdAt: new Date().toISOString() });</span>
<span>            topicsDB.push({ id: "raw_"+Date.now(), title: title, subject: subject, rawContent: rawText });</span>
<span>            saveAllData();</span>
<span>            document.getElementById('rawTextArea').value = '';</span>
<span>            showToast("‚úÖ Raw notes stored exactly as written.");</span>
<span>        }</span>
<span>    }</span>
<span></span>
<span>    // ---------- REAL PROGRESS TRACKING ----------</span>
<span>    function markTopicComplete() {</span>
<span>        let urlParams = new URLSearchParams(window.location.hash);</span>
<span>        let topicId = sessionStorage.getItem("currentTopicId");</span>
<span>        if(!topicId) { showToast("Topic not recognized"); return; }</span>
<span>        if(!userProgress[currentUser]) userProgress[currentUser] = { completed: [], points: 0 };</span>
<span>        if(!userProgress[currentUser].completed.includes(topicId)) {</span>
<span>            userProgress[currentUser].completed.push(topicId);</span>
<span>            userProgress[currentUser].points += 10;</span>
<span>            saveAllData();</span>
<span>            showToast(`üéâ Completed! +10 points. Total: ${userProgress[currentUser].points}`);</span>
<span>            renderProgressPage();</span>
<span>        } else { showToast("Already completed this topic ‚úîÔ∏è"); }</span>
<span>    }</span>
<span></span>
<span>    function renderProgressPage() {</span>
<span>        let container = document.getElementById('progressList');</span>
<span>        if(!container) return;</span>
<span>        let data = userProgress[currentUser] || { completed: [], points: 0 };</span>
<span>        let totalTopics = topicsDB.length;</span>
<span>        let completedCount = data.completed.length;</span>
<span>        let percent = totalTopics ? (completedCount/totalTopics*100).toFixed(0) : 0;</span>
<span>        document.getElementById('currentUserDisplay').innerText = currentUser === 'guest' ? 'Guest User (local)' : currentUser;</span>
<span>        container.innerHTML = `</span>
<span>            <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>progress-bar-bg<span class="token punctuation">"</span></span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>margin: 20px 0;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>progress-fill<span class="token punctuation">"</span></span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>width: ${percent}%;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span></span>
<span>            <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>p</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>strong</span><span class="token punctuation">&gt;</span></span>Points:<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>strong</span><span class="token punctuation">&gt;</span></span> ${data.points} | <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>strong</span><span class="token punctuation">&gt;</span></span>Topics mastered:<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>strong</span><span class="token punctuation">&gt;</span></span> ${completedCount}/${totalTopics}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>p</span><span class="token punctuation">&gt;</span></span></span>
<span>            <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>h3</span><span class="token punctuation">&gt;</span></span>‚úÖ Completed Topics:<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>h3</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>ul</span><span class="token punctuation">&gt;</span></span>${data.completed.map(id =&gt; `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>li</span><span class="token punctuation">&gt;</span></span>${topicsDB.find(t=&gt;t.id==id)?.title || id}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>li</span><span class="token punctuation">&gt;</span></span>`).join('') || '<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>li</span><span class="token punctuation">&gt;</span></span>None yet. Start studying!<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>li</span><span class="token punctuation">&gt;</span></span>'}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>ul</span><span class="token punctuation">&gt;</span></span></span>
<span>        `;</span>
