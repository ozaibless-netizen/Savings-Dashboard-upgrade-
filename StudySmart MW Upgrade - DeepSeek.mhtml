<span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>script</span><span class="token punctuation">&gt;</span></span></span>
<span>    // ---------- DATA MODELS ----------</span>
<span>    let topicsDB = JSON.parse(localStorage.getItem("studysmart_topics")) || [</span>
<span>        { id: "dna", title: "DNA &amp; Genetics", subject: "biology", rawContent: "DNA (Deoxyribonucleic Acid) is the hereditary material. Structure: Double helix with base pairs A-T and G-C. Key points: DNA replicates semi-conservatively. RNA uses Uracil instead of Thymine. Exam tip: Learn the Central Dogma (DNA ‚Üí RNA ‚Üí Protein)." },</span>
<span>        { id: "macbeth", title: "Macbeth - Themes &amp; Analysis", subject: "english", rawContent: "Macbeth by Shakespeare: Themes include ambition, guilt, supernatural. Key quotes: 'Out, damned spot!' and 'Is this a dagger?'. For MSCE essays, analyze how ambition corrupts Macbeth." },</span>
<span>        { id: "trigonometry", title: "Trigonometry Basics", subject: "mathematics", rawContent: "SOH-CAH-TOA: Sin = Opposite/Hypotenuse, Cos = Adjacent/Hypotenuse, Tan = Opposite/Adjacent. Always draw the triangle first. Exam questions often require finding missing sides/angles." },</span>
<span>        { id: "bonding", title: "Chemical Bonding", subject: "chemistry", rawContent: "Ionic (metal+nonmetal, electron transfer), Covalent (nonmetal+nonmetal, electron sharing), Metallic (metal+metal, sea of electrons). Properties: Ionic compounds have high melting points, conduct when dissolved." },</span>
<span>        { id: "pearl", title: "The Pearl by Steinbeck", subject: "english", rawContent: "The Pearl is a parable about greed. Kino finds a pearl hoping for wealth, but it brings violence and tragedy. Key themes: greed, colonialism, family. The pearl symbolizes false hope." }</span>
<span>    ];</span>
<span>    let userProgress = JSON.parse(localStorage.getItem("studysmart_progress")) || { "guest": { completed: [], points: 0 } };</span>
<span>    let currentUser = "guest";</span>
<span>    let loggedAdmin = false;</span>
<span>    let currentTopicId = null;</span>
<span></span>
<span>    // Helper functions</span>
<span>    function saveData() { localStorage.setItem("studysmart_topics", JSON.stringify(topicsDB)); localStorage.setItem("studysmart_progress", JSON.stringify(userProgress)); }</span>
<span>    function showToast(msg) { let t = document.getElementById('toastMsg'); t.innerText = msg; t.classList.add('show'); setTimeout(()=&gt;t.classList.remove('show'),3000); }</span>
<span>    function showPage(pageId) { document.querySelectorAll('.page').forEach(p =&gt; p.classList.remove('active')); document.getElementById(`page-${pageId}`).classList.add('active'); if(pageId === 'progress') renderProgressPage(); if(pageId === 'admin-dashboard' &amp;&amp; loggedAdmin) renderAdminDashboard(); }</span>
<span>    </span>
<span>    // Render subjects page</span>
<span>    function renderSubjectsPage() {</span>
<span>        const subjects = ["biology","chemistry","mathematics","physics","english","agriculture"];</span>
<span>        const icons = { biology:"üß¨", chemistry:"‚öóÔ∏è", mathematics:"üìê", physics:"‚ö°", english:"üìñ", agriculture:"üå±" };</span>
<span>        let html = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>subjects-grid<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        subjects.forEach(sub =&gt; { html += `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>subject-card<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>openSubject('${sub}')<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>subject-icon<span class="token punctuation">"</span></span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>background:#f0f0f0;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>${icons[sub]}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>h3</span><span class="token punctuation">&gt;</span></span>${sub.charAt(0).toUpperCase()+sub.slice(1)}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>h3</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`; });</span>
<span>        html += `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        document.getElementById('allSubjectsGrid').innerHTML = html;</span>
<span>    }</span>
<span>    function openSubject(subject) {</span>
<span>        let filtered = topicsDB.filter(t =&gt; t.subject === subject);</span>
<span>        let container = document.getElementById('subjectDetailContent');</span>
<span>        container.innerHTML = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>h2</span><span class="token punctuation">&gt;</span></span>${subject.toUpperCase()} Topics<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>h2</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>margin-top:20px;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>${filtered.map(t =&gt; `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>topic-card<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>viewTopic('${t.id}')<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>strong</span><span class="token punctuation">&gt;</span></span>üìò ${t.title}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>strong</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>p</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>color: gray; font-size:0.85rem; margin-top:8px;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>${t.rawContent.substring(0,100)}...<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>p</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`).join('') || '<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>p</span><span class="token punctuation">&gt;</span></span>No topics yet. Admin can add raw notes.<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>p</span><span class="token punctuation">&gt;</span></span>'}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        showPage('subject-detail');</span>
<span>    }</span>
<span>    function viewTopic(id) {</span>
<span>        let topic = topicsDB.find(t =&gt; t.id == id);</span>
<span>        if(!topic) return showToast("Topic not found");</span>
<span>        currentTopicId = id;</span>
<span>        let completed = userProgress[currentUser]?.completed.includes(id) || false;</span>
<span>        let completeBtnHtml = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>button</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>btn btn-primary<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>markTopicComplete()<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>i</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>fas fa-check-circle<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>i</span><span class="token punctuation">&gt;</span></span> ${completed ? "Already Completed" : "Mark as Completed"}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>button</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        document.getElementById('topicFullContent').innerHTML = `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>h1</span><span class="token punctuation">&gt;</span></span>${topic.title}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>h1</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>background:white; padding:28px; border-radius:var(--radius); margin-top:16px; white-space:pre-wrap; line-height:1.7;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>${topic.rawContent}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`;</span>
<span>        document.getElementById('markCompleteBtn').innerHTML = completed ? "‚úÖ Completed" : "üìå Mark as Completed";</span>
<span>        showPage('topic-view');</span>
<span>    }</span>
<span>    function markTopicComplete() {</span>
<span>        if(!currentTopicId) { showToast("No topic selected"); return; }</span>
<span>        if(!userProgress[currentUser]) userProgress[currentUser] = { completed: [], points: 0 };</span>
<span>        if(userProgress[currentUser].completed.includes(currentTopicId)) { showToast("Already completed this topic!"); return; }</span>
<span>        userProgress[currentUser].completed.push(currentTopicId);</span>
<span>        userProgress[currentUser].points += 10;</span>
<span>        saveData();</span>
<span>        renderProgressPage();</span>
<span>        showToast(`üéâ Completed! +10 points. Total: ${userProgress[currentUser].points}`);</span>
<span>        viewTopic(currentTopicId); // refresh button</span>
<span>    }</span>
<span>    function renderProgressPage() {</span>
<span>        let data = userProgress[currentUser] || { completed: [], points: 0 };</span>
<span>        let totalTopics = topicsDB.length;</span>
<span>        let completedCount = data.completed.length;</span>
<span>        let percent = totalTopics ? (completedCount/totalTopics*100).toFixed(0) : 0;</span>
<span>        document.getElementById('progressOverview').innerHTML = `</span>
