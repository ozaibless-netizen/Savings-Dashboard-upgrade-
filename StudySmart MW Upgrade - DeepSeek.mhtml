<span>    function renderRawNotesList() { let listDiv = document.getElementById('rawNotesListAdmin'); if(listDiv) listDiv.innerHTML = topicsDB.map(t =&gt; `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>border:1px solid #ddd; margin:8px; padding:12px; border-radius:8px;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>b</span><span class="token punctuation">&gt;</span></span>${t.title}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>b</span><span class="token punctuation">&gt;</span></span> (${t.subject})<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>br</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>small</span><span class="token punctuation">&gt;</span></span>${t.rawContent.substring(0,100)}...<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>small</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>br</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>button</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>btn btn-outline<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>editTopicRaw('${t.id}')<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>Edit Raw<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>button</span><span class="token punctuation">&gt;</span></span> <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>button</span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>deleteTopic('${t.id}')<span class="token punctuation">"</span></span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>background:none; color:red; border:none; cursor:pointer;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>Delete<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>button</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`).join(''); }</span>
<span>    function renderManageTopics() { let div = document.getElementById('manageTopicsList'); if(div) div.innerHTML = topicsDB.map(t =&gt; `<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>div</span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>background:white; margin:10px 0; padding:16px; border-radius:12px;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>strong</span><span class="token punctuation">&gt;</span></span>${t.title}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>strong</span><span class="token punctuation">&gt;</span></span> (${t.subject})<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>br</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>textarea</span> <span class="token attr-name">id</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>edit-${t.id}<span class="token punctuation">"</span></span> <span class="token attr-name">rows</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>3<span class="token punctuation">"</span></span> <span class="token attr-name">style</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>width:100%; margin-top:8px;<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>${t.rawContent}<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>textarea</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>br</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>button</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>btn btn-primary<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>updateTopicRaw('${t.id}')<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>Save Changes<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>button</span><span class="token punctuation">&gt;</span></span> <span class="token tag"><span class="token tag"><span class="token punctuation">&lt;</span>button</span> <span class="token attr-name">class</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>btn btn-outline<span class="token punctuation">"</span></span> <span class="token attr-name">onclick</span><span class="token attr-value"><span class="token punctuation attr-equals">=</span><span class="token punctuation">"</span>deleteTopic('${t.id}')<span class="token punctuation">"</span></span><span class="token punctuation">&gt;</span></span>Delete<span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>button</span><span class="token punctuation">&gt;</span></span><span class="token tag"><span class="token tag"><span class="token punctuation">&lt;/</span>div</span><span class="token punctuation">&gt;</span></span>`).join('');</span>
<span>    }</span>
<span>    window.handleRawFile = function(e) {</span>
<span>        let file = e.target.files[0];</span>
<span>        if(!file) return;</span>
<span>        let reader = new FileReader();</span>
<span>        reader.onload = function(ev) { document.getElementById('rawTextArea').value = ev.target.result; showToast("File loaded. Click 'Save as New Topic'"); };</span>
<span>        reader.readAsText(file);</span>
<span>    };</span>
<span>    window.saveRawNotes = function() {</span>
<span>        let rawContent = document.getElementById('rawTextArea').value.trim();</span>
<span>        if(!rawContent) { showToast("Please paste or upload notes first"); return; }</span>
<span>        let title = prompt("Topic title:", "New Study Notes");</span>
<span>        let subject = prompt("Subject (biology, chemistry, mathematics, physics, english, agriculture):", "general");</span>
<span>        if(title &amp;&amp; subject) {</span>
<span>            let newId = "topic_" + Date.now();</span>
<span>            topicsDB.push({ id: newId, title: title, subject: subject, rawContent: rawContent });</span>
<span>            saveData();</span>
<span>            document.getElementById('rawTextArea').value = '';</span>
<span>            showToast("Raw notes saved successfully (NO summarization)");</span>
<span>            renderAdminDashboard();</span>
<span>            setAdminTab('upload');</span>
<span>        }</span>
<span>    };</span>
<span>    window.editTopicRaw = function(id) { let topic = topicsDB.find(t=&gt;t.id==id); if(topic) { let newContent = prompt("Edit raw content (exact text):", topic.rawContent); if(newContent !== null) { topic.rawContent = newContent; saveData(); renderAdminDashboard(); setAdminTab('manage'); showToast("Updated"); } } };</span>
<span>    window.updateTopicRaw = function(id) { let topic = topicsDB.find(t=&gt;t.id==id); let newVal = document.getElementById(`edit-${id}`).value; if(topic) { topic.rawContent = newVal; saveData(); showToast("Topic updated"); renderAdminDashboard(); setAdminTab('manage'); } };</span>
<span>    window.deleteTopic = function(id) { topicsDB = topicsDB.filter(t=&gt;t.id!=id); saveData(); renderAdminDashboard(); setAdminTab('manage'); showToast("Deleted"); };</span>
<span>    window.updateAdminCredentials = function() { let newEmail = document.getElementById('adminNewEmail').value; let newPass = document.getElementById('adminNewPass').value; if(newEmail &amp;&amp; newPass) { localStorage.setItem("admin_email", newEmail); localStorage.setItem("admin_pass", newPass); showToast("Admin credentials updated (local storage). Use new details next login."); } };</span>
<span>    function resetAllProgress() { userProgress = { "guest": { completed: [], points: 0 } }; saveData(); renderAdminDashboard(); setAdminTab('progress'); showToast("All user progress reset"); }</span>
<span></span>
<span>    // Expose globals</span>
<span>    window.showPage = showPage; window.openSubject = openSubject; window.viewTopic = viewTopic; window.markTopicComplete = markTopicComplete;</span>
<span>    window.sendAIMessage = sendAIMessage; window.openAdminLogin = openAdminLogin; window.performAdminLogin = performAdminLogin;</span>
<span>    window.logoutAdmin = logoutAdmin; window.resetGuestProgress = resetGuestProgress; window.deleteTopic = deleteTopic;</span>
<span>    window.editTopicRaw = editTopicRaw; window.updateTopicRaw = updateTopicRaw; window.updateAdminCredentials = updateAdminCredentials;</span>
<span>    window.resetAllProgress = resetAllProgress; window.handleRawFile = handleRawFile; window.saveRawNotes = saveRawNotes;</span>
<span>    </span>
<span>    // Initialize</span>
<span>    renderSubjectsPage();</span>
<span>    if(!userProgress.guest) userProgress.guest = { completed: [], points: 0 };</span>
<span>    saveData();</span>
